# ============================================================
# IMX219 MIPI CSI-2 clock-domain constraints
# ============================================================

# Pixel/parallel clock generated by PF_CCC: 182.4 MHz
set_clock_groups \
    -asynchronous \
    -group [get_clocks {
        FIC_3_PERIPHERALS_0/PF_CCC_C1_0/PF_CCC_C1_0/pll_inst_0/OUT0
    }]

# Byte clock generated inside PF_IOD: 114 MHz
set_clock_groups \
    -asynchronous \
    -group [get_clocks {
        FIC_3_PERIPHERALS_0/PF_IOD_GENERIC_RX_C0_0/PF_CLK_DIV_FIFO/I_CDD/Y_DIV
    }]